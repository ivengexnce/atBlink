rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models
    // ===============================================================
    //
    // Collection: users/{userId}
    // Fields:
    //   - id: string (user UID)
    //   - name: string
    //   - email: string
    //   - phone: string (optional)
    //   - address: string (optional)
    //   - photoUrl: string (optional)
    //   - bio: string (optional)
    //   - authMethod: string ('google', 'email', 'guest')
    //   - createdAt: timestamp / string
    //   - lastLoginAt: timestamp
    //   - updatedAt: timestamp
    //
    // Collection: products/{productId}
    // Fields:
    //   - id: int
    //   - title: string
    //   - category: string
    //   - brand: string
    //   - price: number
    //   - discountPercentage: number
    //   - stock: int
    //   - unitQuantity: string
    //   - deliveryEta: string
    //   - thumbnail: string
    //   - description: string
    //   - updatedAt: timestamp
    //
    // Collection: orders/{orderId}
    // Fields:
    //   - orderId: string
    //   - userId: string
    //   - customerName: string
    //   - deliveryAddress: string
    //   - items: list
    //   - totalAmount: number
    //   - orderStatus: string
    //   - orderedAt: timestamp / string
    //
    // Collection: product_reviews/{reviewId}
    // Fields:
    //   - id: string
    //   - productId: int
    //   - userId: string
    //   - rating: number
    //   - comment: string
    //   - createdAt: timestamp / string
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------
    // 1. PRODUCTS CATALOG COLLECTION
    // ---------------------------------------------------------------
    match /products/{productId} {
      // Anyone can browse products in the storefront
      allow read: if true;

      // Only authenticated store managers and admins can add, edit, or delete items
      allow write: if isAuthenticated();
    }

    // ---------------------------------------------------------------
    // 2. USERS & PRIVATE USER DATA
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Users can only view and modify their own personal profile
      allow read, write: if isOwner(userId);

      // User-specific order subcollection
      match /orders/{orderId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------
    // 3. GLOBAL ORDERS COLLECTION
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      // Shoppers can only view their own placed orders
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );

      // Authenticated users can place orders tied to their own account
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Updating order status
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // 4. PRODUCT REVIEWS COLLECTION
    // ---------------------------------------------------------------
    match /product_reviews/{reviewId} {
      // Anyone can read community ratings and reviews
      allow read: if true;

      // Only authenticated shoppers can post reviews for their own UID
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Only the author can edit or delete their review
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}

